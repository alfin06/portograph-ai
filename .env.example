# ==========================================
# PortoGraph AI - Environment Configuration
# ==========================================

# --- 1. AI Reasoning Engine ---
# Get this from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"

# --- 2. Telegram UI & Notifications ---
# Get this by messaging @BotFather on Telegram and sending /newbot
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Leave this blank initially. Run `python core/telegram_bot.py`, 
# message your bot /start, and it will give you your Chat ID. 
# Then paste that number here and restart the bot.
TELEGRAM_CHAT_ID=""