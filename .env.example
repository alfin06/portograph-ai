# ==========================================
# PortoGraph AI - Environment Configuration
# ==========================================

# --- 1. AI Reasoning Engine (OpenAI-compatible endpoint, e.g. Forge) ---
FORGE_API_KEY="your_forge_api_key_here"
FORGE_BASE_URL="https://your-forge-endpoint/v1"
MODEL_NAME="tensorblock/gpt-5-mini"

# --- 2. Telegram UI & Notifications ---
# Get this by messaging @BotFather on Telegram and sending /newbot
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Leave this blank initially. Run `python -m core.telegram_bot`,
# message your bot /start, and it will give you your Chat ID.
# Then paste that number here and restart the bot.
# The bot only answers this chat ID once it is set.
TELEGRAM_CHAT_ID=""

# --- 3. Optional modules ---
ENABLE_CRYPTO="false"

# --- 4. Alerts ---
# Minimum hours before the same alert (ticker + type) can fire again
ALERT_COOLDOWN_HOURS="12"

# --- 5. Daily digests (Mon-Fri, in each exchange's own time zone) ---
DIGEST_IDX_TIME="16:30"   # Asia/Jakarta (IDX closes 16:00)
DIGEST_US_TIME="17:00"    # America/New_York (NYSE closes 16:00; DST handled)

# --- 6. Hosting (defaults suit running on your own PC; leave blank) ---
# Where the database and its backups live. Docker sets DATA_DIR=/app/data itself.
# DATA_DIR=""
# LOG_DIR=""
# BACKUP_KEEP="14"          # daily backups to keep
# CATCHUP_HOURS="20"        # after sleep/shutdown, send a missed digest if it's at most this late

# --- 7. Web dashboard (python -m app.run starts it; http://127.0.0.1:8000) ---
# WEB_PORT="8000"
# WEB_ENABLED="true"        # false = bot and worker only
# Only this computer can open the dashboard. To open it from your phone on home Wi-Fi
# (or on a server), set WEB_HOST="0.0.0.0" AND a password; it refuses to start without one.
# WEB_HOST="127.0.0.1"
# WEB_PASSWORD=""           # browser asks for it; any username
